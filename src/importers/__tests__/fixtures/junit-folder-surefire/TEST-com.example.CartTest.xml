<?xml version="1.0" encoding="UTF-8"?>
<!-- Written by hand, NOT taken from a live run: the shape follows Maven Surefire's XML report schema
     (maven-surefire-plugin 3.x, JUnit Platform provider), one TEST-<class>.xml per class in target/surefire-reports.
     The test's stdout sits in its own testcase, where System.out.println("[[ATTACHMENT|...]]") puts it. -->
<testsuite xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://maven.apache.org/surefire/maven-surefire-plugin/xsd/surefire-test-report-3.0.xsd" version="3.0" name="com.example.CartTest" time="0.045" tests="2" errors="0" skipped="0" failures="1">
  <properties>
    <property name="java.version" value="21.0.4"/>
    <property name="surefire.test.class.path" value="/work/target/test-classes:/work/target/classes"/>
  </properties>
  <testcase name="addsAnItem()" classname="com.example.CartTest" time="0.012"/>
  <testcase name="rejectsANegativeQuantity()" classname="com.example.CartTest" time="0.009">
    <failure message="expected: &lt;true&gt; but was: &lt;false&gt;" type="org.opentest4j.AssertionFailedError"><![CDATA[org.opentest4j.AssertionFailedError: expected: <true> but was: <false>
	at com.example.CartTest.rejectsANegativeQuantity(CartTest.java:21)
]]></failure>
    <system-out><![CDATA[cart total after -1: 0.00
[[ATTACHMENT|artifacts/cart-total.txt]]
]]></system-out>
  </testcase>
</testsuite>
