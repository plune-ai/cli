        "ms": 0
      },
      {
        "id": "ping",
        "ms": 0
      }
    ],
    "calls": [
      {
        "tool": "read_ok",
        "ms": 0
      },
      {
        "tool": "read_error",
        "ms": 0
      },
      {
        "tool": "read_rpc_error",
        "ms": 0
